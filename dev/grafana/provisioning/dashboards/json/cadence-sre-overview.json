      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",error_type!=\"\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[5m])), 1)",
