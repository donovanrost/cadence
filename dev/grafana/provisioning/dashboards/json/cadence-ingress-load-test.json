      "title": "Traffic and processing",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "greptimedb-prometheus"},
      "description": "Latest successful TCP receive throughput at Cadence's transport boundary.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(cadence_telemetry_ingress_received_bytes_total{service_name=~\"$service\",cadence_telemetry_direction=~\"$direction\",cadence_telemetry_protocol_family=~\"$protocol\"}[$__rate_interval])) * 8",
          "legendFormat": "receive",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Current wire receive rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "greptimedb-prometheus"},
      "description": "Processed-byte rate divided by receive-byte rate. Brief deviation is expected while queues fill or drain.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.9},
              {"color": "green", "value": 0.99}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(cadence_telemetry_ingress_processed_bytes_total{service_name=~\"$service\",cadence_telemetry_direction=~\"$direction\",cadence_telemetry_protocol_family=~\"$protocol\"}[1m])) / clamp_min(sum(rate(cadence_telemetry_ingress_received_bytes_total{service_name=~\"$service\",cadence_telemetry_direction=~\"$direction\",cadence_telemetry_protocol_family=~\"$protocol\"}[1m])), 1)",
          "legendFormat": "processed / received",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Processing coverage (1m)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "greptimedb-prometheus"},
      "description": "Raw bytes currently represented by all provider ingress executor queues.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}]},
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "cadence_telemetry_ingress_queue_size_bytes{service_name=~\"$service\"}",
          "legendFormat": "queued bytes",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Ingress byte backlog",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "greptimedb-prometheus"},
      "description": "One means an ingress executor or persistence projector is actively applying backpressure.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [{"options": {"0": {"color": "green", "text": "Clear"}, "1": {"color": "red", "text": "Active"}}, "type": "value"}],
          "max": 1,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(cadence_telemetry_ingress_backpressure{service_name=~\"$service\"})",
          "legendFormat": "backpressure",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Backpressure",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "greptimedb-prometheus"},
      "description": "Transport-boundary receive throughput versus successfully processed raw bytes. Target is the editable dashboard variable.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}},
          "unit": "bps"
        },
        "overrides": [{"matcher": {"id": "byName", "options": "target"}, "properties": [{"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}}, {"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]}]
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 5,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [
        {"editorMode": "code", "expr": "sum(rate(cadence_telemetry_ingress_received_bytes_total{service_name=~\"$service\",cadence_telemetry_direction=~\"$direction\",cadence_telemetry_protocol_family=~\"$protocol\"}[$__rate_interval])) * 8", "legendFormat": "received", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum(rate(cadence_telemetry_ingress_processed_bytes_total{service_name=~\"$service\",cadence_telemetry_direction=~\"$direction\",cadence_telemetry_protocol_family=~\"$protocol\"}[$__rate_interval])) * 8", "legendFormat": "processed", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "vector($target_mbps * 1000000)", "legendFormat": "target", "range": true, "refId": "C"}
      ],
      "title": "Receive and processing throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "greptimedb-prometheus"},
      "description": "TCP receive sizes may vary with kernel buffering. Capture records remain small durability units while semantic batches amortize processing overhead within a separate bound.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}}, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 6},
