      "targets": [
        {"editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le) (rate(cadence_telemetry_ingress_receive_size_bytes_bucket{service_name=~\"$service\",cadence_telemetry_direction=~\"$direction\",cadence_telemetry_protocol_family=~\"$protocol\"}[$__rate_interval])))", "legendFormat": "p50", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(cadence_telemetry_ingress_receive_size_bytes_bucket{service_name=~\"$service\",cadence_telemetry_direction=~\"$direction\",cadence_telemetry_protocol_family=~\"$protocol\"}[$__rate_interval])))", "legendFormat": "p95", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "histogram_quantile(0.99, sum by (le) (rate(cadence_telemetry_ingress_receive_size_bytes_bucket{service_name=~\"$service\",cadence_telemetry_direction=~\"$direction\",cadence_telemetry_protocol_family=~\"$protocol\"}[$__rate_interval])))", "legendFormat": "TCP p99", "range": true, "refId": "C"},
        {"editorMode": "code", "expr": "histogram_quantile(0.99, sum by (le) (rate(cadence_telemetry_ingress_journal_record_size_bytes_bucket{service_name=~\"$service\"}[$__rate_interval])))", "legendFormat": "capture record p99", "range": true, "refId": "D"},
        {"editorMode": "code", "expr": "histogram_quantile(0.99, sum by (le) (rate(cadence_telemetry_ingress_journal_processing_batch_size_bytes_bucket{service_name=~\"$service\"}[$__rate_interval])))", "legendFormat": "semantic batch p99", "range": true, "refId": "E"}
