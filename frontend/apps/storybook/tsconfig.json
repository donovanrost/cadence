{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    ".storybook/**/*.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "../../packages/ui/src/**/*.stories.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client", "vite-plus/test"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
