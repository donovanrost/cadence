{
  "extends": ["@vue/tsconfig/tsconfig.dom.json", "../../tsconfig.strict.json"],
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client", "vite-plus/test", "node"],
    "paths": {
      "@/ui/index.ts": ["./src/ui.ts"],
      "@/lib/index.ts": ["./src/ui.ts"],
      "@/lib/format.ts": ["./src/ui.ts"],
      "@/*": ["./src/*"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "vueCompilerOptions": {
    "checkUnknownComponents": true
  }
}
