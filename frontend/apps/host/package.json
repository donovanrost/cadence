    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@module-federation/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/phoenix": "^1.6.7",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vue/tsconfig": "catalog:",
    "happy-dom": "catalog:",
    "tidewave": "0.9.0",
