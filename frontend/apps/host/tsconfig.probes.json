{
  "extends": ["../../tsconfig.strict.json"],
  "include": ["src/**/*.mjs", "*.mjs"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.probes.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "skipLibCheck": true
  }
}
