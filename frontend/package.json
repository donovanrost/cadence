{
  "name": "@cadence/federated-frontend-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "build:publication": "node tools/build-first-party-publication.mjs && node tools/production-publication-output-check.mjs",
    "release:package": "node tools/frontend-release-package.mjs",
    "test:publication": "node tools/production-publication-output-check.mjs",
    "test:browser:contract": "node --test ../apps/cadence_web/assets/test/federation_browser_smoke_contract_test.mjs ../apps/cadence_web/assets/test/federation_browser_smoke_hardening_test.mjs ../apps/cadence_web/assets/test/federation_publication_build_lock_test.mjs",
    "preview": "node tools/production-server.ts",
    "check": "vp check",
    "test": "vp run -r test",
    "storybook": "corepack pnpm --filter @cadence/storybook storybook",
    "storybook:build": "corepack pnpm --filter @cadence/storybook build-storybook",
    "storybook:test": "corepack pnpm --filter @cadence/storybook test"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.16.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.22.0"
}
