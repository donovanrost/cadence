{
  "extends": ["@vue/tsconfig/tsconfig.dom.json", "../../tsconfig.strict.json"],
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.mjs", "src/**/*.js", "vite.config.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "types": ["vite/client", "vite-plus/test", "node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "allowJs": true,
    "checkJs": true
  }
}
