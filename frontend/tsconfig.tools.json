{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["tools/**/*.ts", "tools/**/*.mjs", "test-support/**/*.ts", "vite.config.ts"],
  "extends": ["./tsconfig.strict.json"]
}
