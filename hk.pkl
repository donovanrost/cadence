amends "package://github.com/jdx/hk/releases/download/v1.28.0/hk@1.28.0#/Config.pkl"

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps {
            ["elixir-format"] {
                glob = List("*.ex", "*.exs")
                check = "mix format --check-formatted {{files}}"
                fix = "mix format {{files}}"
            }
        }
    }
    ["fix"] {
        fix = true
        steps {
            ["elixir-format"] {
                glob = List("*.ex", "*.exs")
                check = "mix format --check-formatted {{files}}"
                fix = "mix format {{files}}"
            }
        }
    }
    ["check"] {
        steps {
            ["elixir-format"] {
                glob = List("*.ex", "*.exs")
                check = "mix format --check-formatted {{files}}"
            }
        }
    }
}
