amends "package://github.com/jdx/hk/releases/download/v1.56.0/hk@1.56.0#/Config.pkl"

hooks {
    ["pre-commit"] {
        fix = true
        // "none": several agents share one worktree; stashing would hide their
        // uncommitted files for the whole precommit run.
        stash = "none"
        steps {
            ["elixir-format"] {
                glob = List("*.ex", "*.exs")
                check = "mix format.all --check-formatted {{files}}"
                fix = "mix format.all {{files}}"
            }
            ["precommit-affected"] {
                profiles = List("!full")
                check = "mix precommit.affected"
                stdin = ""
                exclusive = true
            }
            ["precommit-full"] {
                profiles = List("full")
                check = "mix precommit"
                stdin = ""
                exclusive = true
            }
        }
    }
    ["fix"] {
        fix = true
        steps {
            ["elixir-format"] {
                glob = List("*.ex", "*.exs")
                check = "mix format.all --check-formatted {{files}}"
                fix = "mix format.all {{files}}"
            }
        }
    }
    ["check"] {
        steps {
            ["elixir-format"] {
                glob = List("*.ex", "*.exs")
                check = "mix format.all --check-formatted {{files}}"
            }
        }
    }
}
