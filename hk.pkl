amends "package://github.com/jdx/hk/releases/download/v1.28.0/hk@1.28.0#/Config.pkl"

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps {
            ["css-frozen"] {
                glob = List("*.css")
                check = "scripts/check-css-frozen.sh"
            }
            ["elixir-format"] {
                glob = List("*.ex", "*.exs")
                check = "mix format.all --check-formatted {{files}}"
                fix = "mix format.all {{files}}"
            }
            ["precommit-affected"] {
                profiles = List("!full")
                check = "mix precommit.affected"
                stdin = ""
                exclusive = true
            }
            ["precommit-full"] {
                profiles = List("full")
                check = "mix precommit"
                stdin = ""
                exclusive = true
            }
        }
    }
    ["fix"] {
        fix = true
        steps {
            ["elixir-format"] {
                glob = List("*.ex", "*.exs")
                check = "mix format.all --check-formatted {{files}}"
                fix = "mix format.all {{files}}"
            }
        }
    }
    ["check"] {
        steps {
            ["elixir-format"] {
                glob = List("*.ex", "*.exs")
                check = "mix format.all --check-formatted {{files}}"
            }
        }
    }
}
