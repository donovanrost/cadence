amends "package://github.com/jdx/hk/releases/download/v1.56.0/hk@1.56.0#/Config.pkl"

hooks {
    ["pre-commit"] {
        fix = true
        // "none": the git stash stack is shared by every worktree of this repo.
        stash = "none"
        steps {
            ["elixir-format"] {
                glob = List("*.ex", "*.exs")
                check = "mix format.all --check-formatted {{files}}"
                fix = "mix format.all {{files}}"
            }
            // Format, compile, credo and the architecture checks. Test suites run in CI
            // (docs/TEAM.md); run the tests for the area you touched yourself.
            ["precommit-checks"] {
                profiles = List("!full")
                check = "mix precommit.checks"
                stdin = ""
                exclusive = true
            }
            ["precommit-full"] {
                profiles = List("full")
                check = "mix precommit"
                stdin = ""
                exclusive = true
            }
        }
    }
    ["fix"] {
        fix = true
        steps {
            ["elixir-format"] {
                glob = List("*.ex", "*.exs")
                check = "mix format.all --check-formatted {{files}}"
                fix = "mix format.all {{files}}"
            }
        }
    }
    ["check"] {
        steps {
            ["elixir-format"] {
                glob = List("*.ex", "*.exs")
                check = "mix format.all --check-formatted {{files}}"
            }
        }
    }
}
