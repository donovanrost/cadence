<.vue
  id="application-shell"
  v-component="ApplicationShell"
  v-socket={assigns[:socket]}
  variant="ops"
  context={CadenceWeb.HostContext.from_assigns(assigns)}
  v-ssr={false}
/>
{@inner_content}
<LiveToast.toast_group
  flash={@flash}
  connected={assigns[:socket] != nil}
  toasts_sync={assigns[:toasts_sync]}
/>
