<div class="relative min-h-screen overflow-hidden">
  <div class="absolute inset-0 pointer-events-none bg-[linear-gradient(125deg,rgba(134,214,255,0.06),transparent_42%),linear-gradient(305deg,rgba(245,182,111,0.08),transparent_38%)]">
  </div>
  <div class="absolute inset-0 pointer-events-none bg-[linear-gradient(rgba(134,214,255,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(134,214,255,0.05)_1px,transparent_1px)] bg-[length:4rem_4rem] [mask-image:linear-gradient(180deg,rgba(0,0,0,0.6),transparent_92%)]">
  </div>

  <div class="relative z-10 w-[min(72rem,calc(100vw-2.5rem))] mx-auto py-8 pb-12 max-md:py-6 max-md:pb-10">
    <.app_header current_scope={@current_scope} />
    <main class="relative">
      {@inner_content}
    </main>
  </div>

  <.flash_stack flash={@flash} />
</div>
