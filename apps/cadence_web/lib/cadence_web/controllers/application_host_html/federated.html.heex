<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div
    id="cadence-federation-root"
    data-organization-id={@organization_id}
    data-user-id={@user_id}
    data-mission-id={@mission_id}
    data-spacecraft-id={@spacecraft_id}
    data-host-scope={@host_scope}
    data-application-key={@application_key}
    data-surface-id={@surface_id}
    data-catalog-url={@catalog_url}
    data-fallback-href={@fallback_href}
  >
  </div>
  <link rel="stylesheet" href="/assets/application-host/host/plugin-host.css">
</Layouts.app>
