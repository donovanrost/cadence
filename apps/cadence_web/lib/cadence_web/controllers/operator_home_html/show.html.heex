<section id="operator-home" class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-base-content">Operator Home</h1>
    <p class="mt-1 text-sm text-base-content/50">
      Welcome to the Cadence control plane.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="card bg-base-200">
      <div class="card-body p-4">
        <p class="hud-label">Actor</p>
        <%= cond do %>
          <% @current_scope.user -> %>
            <p class="font-semibold">{@current_scope.user.display_name}</p>
            <p class="text-sm text-base-content/60">{@current_scope.user.email}</p>
          <% @current_scope.service_identity -> %>
            <p class="font-semibold">{@current_scope.service_identity.display_name}</p>
            <p class="text-sm text-base-content/60">{@current_scope.service_identity.service_identity_id}</p>
          <% true -> %>
            <p class="font-semibold">Authenticated</p>
        <% end %>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body p-4">
        <p class="hud-label">Scope</p>
        <p class="font-semibold">
          <%= cond do %>
            <% @current_scope.mission -> %>
              Mission-scoped
            <% @current_scope.organization -> %>
              Organization-scoped
            <% true -> %>
              Platform-scoped
          <% end %>
        </p>
        <p class="text-sm text-base-content/60">
          <%= cond do %>
            <% @current_scope.mission -> %>
              {@current_scope.mission.display_name}
            <% @current_scope.organization -> %>
              {@current_scope.organization.display_name}
            <% true -> %>
              No organization or mission context has been selected yet.
          <% end %>
        </p>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body p-4">
        <p class="hud-label">Coming Soon</p>
        <p class="font-semibold">Missions, telemetry, and commanding</p>
        <p class="text-sm text-base-content/60">
          Mission management, real-time telemetry, and spacecraft commanding surfaces are coming
          in upcoming releases.
        </p>
      </div>
    </div>
  </div>

</section>
