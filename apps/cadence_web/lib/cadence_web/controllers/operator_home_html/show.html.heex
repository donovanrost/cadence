<section id="operator-home" class="space-y-6">
  <div>
    <p class="hud-label">Operator Home</p>
    <h1 class="text-2xl font-bold text-base-content">
      Authenticated traffic now lands on a stable operator entrypoint.
    </h1>
    <p class="mt-2 text-sm text-base-content/50 max-w-2xl">
      This page is intentionally spare. It proves the browser session, route shape, and
      <code class="text-primary">current_scope</code>
      plumbing that the shell work will build on next.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="card bg-base-200">
      <div class="card-body p-4">
        <p class="hud-label">Actor</p>
        <%= cond do %>
          <% @current_scope.user -> %>
            <p class="font-semibold">{@current_scope.user.display_name}</p>
            <p class="text-sm text-base-content/60">{@current_scope.user.email}</p>
          <% @current_scope.service_identity -> %>
            <p class="font-semibold">{@current_scope.service_identity.display_name}</p>
            <p class="text-sm text-base-content/60">{@current_scope.service_identity.service_identity_id}</p>
          <% true -> %>
            <p class="font-semibold">Authenticated</p>
        <% end %>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body p-4">
        <p class="hud-label">Scope</p>
        <p class="font-semibold">
          <%= cond do %>
            <% @current_scope.mission -> %>
              Mission-scoped
            <% @current_scope.organization -> %>
              Organization-scoped
            <% true -> %>
              Platform-scoped
          <% end %>
        </p>
        <p class="text-sm text-base-content/60">
          <%= cond do %>
            <% @current_scope.mission -> %>
              {@current_scope.mission.display_name}
            <% @current_scope.organization -> %>
              {@current_scope.organization.display_name}
            <% true -> %>
              No organization or mission context has been selected yet.
          <% end %>
        </p>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body p-4">
        <p class="hud-label">Next Shell Slices</p>
        <p class="font-semibold">Layout, dashboard, and scoped URLs</p>
        <p class="text-sm text-base-content/60">
          The route is stable now. Subsequent work can add the reusable shell frame and mission-aware
          navigation without revisiting browser auth plumbing.
        </p>
      </div>
    </div>
  </div>

  <.form for={%{}} as={:session} id="sign-out-form" action={~p"/session"} method="delete">
    <button type="submit" class="btn btn-ghost">Sign out</button>
  </.form>
</section>
