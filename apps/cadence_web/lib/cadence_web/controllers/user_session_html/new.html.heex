<section id="sign-in-shell" class="panel panel--hero">
  <div class="eyebrow">First-Run Setup</div>
  <h1 class="hero-title">Cadence setup access now has a browser entrypoint.</h1>
  <p class="hero-copy">
    This first slice keeps the experience intentionally narrow: establish an authenticated browser
    session, then hand control to the protected <code>/setup</code> route for first-run work.
  </p>

  <%= if @setup_access_enabled? do %>
    <.form for={@form} id="setup-access-sign-in-form" action={~p"/sign-in"} class="sign-in-form">
      <.input
        field={@form[:email]}
        type="email"
        label="Setup Access Email"
        placeholder="bootstrap@example.com"
        required
        autocomplete="email"
        autofocus
      />
      <.input
        field={@form[:password]}
        type="password"
        label="Password"
        placeholder="Enter the temporary setup password"
        required
        autocomplete="current-password"
      />

      <p :if={@error_message} id="sign-in-error" class="panel__error">{@error_message}</p>

      <div class="sign-in-form__actions">
        <button type="submit" class="button button--primary">Authenticate</button>
        <p class="sign-in-form__note">
          This path exists only while temporary setup access is enabled for the deployment.
        </p>
      </div>
    </.form>
  <% else %>
    <div id="setup-access-disabled" class="status-card status-card--disabled">
      <p class="status-card__label">Unavailable</p>
      <p class="status-card__body">
        Temporary setup access is disabled for this deployment. Browser setup entry will remain
        closed until another user-facing authentication flow is introduced.
      </p>
    </div>
  <% end %>
</section>
