<section id="sign-in-shell" class="panel panel--hero">
  <div class="eyebrow">Cadence Access</div>
  <h1 class="hero-title">Durable operator sign-in is now the primary browser entrypoint.</h1>
  <p class="hero-copy">
    Browser auth now distinguishes durable user access from temporary first-run setup access. The
    operator sign-in path uses durable human accounts, while the setup path stays isolated until
    first-run handoff work is fully retired.
  </p>

  <div class="summary-grid">
    <article class="status-card">
      <p class="status-card__label">Durable Access</p>
      <p class="status-card__title">Email and password</p>
      <p class="status-card__body">
        Use this path for normal human operator access after your Cadence invitation has been
        accepted.
      </p>
    </article>

    <article class="status-card">
      <p class="status-card__label">Temporary Access</p>
      <p class="status-card__title">
        <%= if @setup_access_available? do %>
          Setup handoff still available
        <% else %>
          Setup access unavailable
        <% end %>
      </p>
      <p class="status-card__body">
        Temporary setup access remains separate from durable operator sessions and only exists while
        first-run setup is still active for the deployment.
      </p>
    </article>
  </div>

  <.form for={@durable_form} id="durable-sign-in-form" action={~p"/sign-in"} class="sign-in-form">
    <.input
      field={@durable_form[:email]}
      type="email"
      label="Email"
      placeholder="operator@example.com"
      required
      autocomplete="email"
      autofocus
    />
    <.input
      field={@durable_form[:password]}
      type="password"
      label="Password"
      placeholder="Enter your password"
      required
      autocomplete="current-password"
    />

    <p :if={@durable_error_message} id="durable-sign-in-error" class="panel__error">
      {@durable_error_message}
    </p>

    <div class="sign-in-form__actions">
      <button type="submit" class="button button--primary">Sign In</button>
      <p class="sign-in-form__note">
        Invitation acceptance creates the durable account. Public self-signup remains closed.
      </p>
    </div>
  </.form>

  <%= if @setup_access_available? do %>
    <.form
      for={@setup_access_form}
      id="setup-access-sign-in-form"
      action={~p"/sign-in"}
      class="sign-in-form"
    >
      <.input
        field={@setup_access_form[:email]}
        type="email"
        label="Setup Access Email"
        placeholder="bootstrap@example.com"
        required
        autocomplete="email"
      />
      <.input
        field={@setup_access_form[:password]}
        type="password"
        label="Setup Password"
        placeholder="Enter the temporary setup password"
        required
        autocomplete="current-password"
      />

      <p :if={@setup_access_error_message} id="setup-sign-in-error" class="panel__error">
        {@setup_access_error_message}
      </p>

      <div class="sign-in-form__actions">
        <button type="submit" class="button button--secondary">Use Setup Access</button>
        <p class="sign-in-form__note">
          This path exists only while temporary setup access is enabled for the deployment.
        </p>
      </div>
    </.form>
  <% end %>
</section>
