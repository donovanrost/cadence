{
  "schema_version": 1,
  "dashboard_id": "dashboard_stale_operational_warning",
  "organization_id": "org_dashboards",
  "mission_id": "mission_dashboards",
  "name": "Stale Operational Warning",
  "description": "Operational observable freshness warning fixture",
  "defaults": {
    "time": {
      "mode": "live",
      "axis": "generation_time",
      "range": {
        "kind": "relative",
        "duration_ms": 300000
      },
      "refresh_ms": 1000
    },
    "scope": {
      "primary": {
        "kind": "mission",
        "mode": "one",
        "ids": ["mission_dashboards"]
      }
    },
    "data": {
      "realm": "flight",
      "source_mode": "primary",
      "allowed_realms": ["flight"]
    },
    "health": {
      "freshness_policy": {
        "stale_after_ms": 1000
      }
    },
    "overlays": {
      "limits": false,
      "quality": false,
      "events": false
    }
  },
  "grid": {
    "columns": 12,
    "row_height_px": 64,
    "gap_px": 8
  },
  "placements": [
    {
      "placement_id": "placement_command_queue",
      "layout": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 2
      },
      "content": {
        "kind": "embedded",
        "widget_def": {
          "widget_type_id": "cadence.value_tile",
          "widget_type_version": 1,
          "title": "Command Queue",
          "binding": {
            "source": "operational_observables",
            "observables": ["commanding.queue_depth"],
            "scope_mode": "context",
            "data_mode": "context",
            "value_type": "engineering",
            "sampling": "latest",
            "overlays": []
          },
          "options": {
            "precision": 0
          }
        }
      }
    }
  ],
  "metadata": {
    "labels": ["golden", "warning", "operational"]
  }
}
