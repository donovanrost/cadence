{
  "schema_version": 1,
  "dashboard_id": "dashboard_time_series_with_limits",
  "organization_id": "org_dashboards",
  "mission_id": "mission_dashboards",
  "name": "Power Trend",
  "description": "Tier 0 time-series fixture with limit overlays",
  "defaults": {
    "time": {
      "mode": "archive",
      "axis": "generation_time",
      "from": "2026-06-16T00:00:00Z",
      "to": "2026-06-16T00:30:00Z"
    },
    "scope": {
      "primary": {
        "kind": "spacecraft",
        "mode": "one",
        "ids": ["sc_001"]
      }
    },
    "data": {
      "realm": "flight",
      "source_mode": "primary",
      "allowed_realms": ["flight"]
    },
    "limits": {
      "semantics_mode": "observed"
    },
    "overlays": {
      "limits": true,
      "events": true,
      "quality": true
    }
  },
  "grid": {
    "columns": 12,
    "row_height_px": 64,
    "gap_px": 8
  },
  "placements": [
    {
      "placement_id": "placement_power_trend",
      "layout": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "content": {
        "kind": "embedded",
        "widget_def": {
          "widget_type_id": "cadence.time_series",
          "widget_type_version": 1,
          "title": "Power Trend",
          "binding": {
            "observables": ["tlm.hk.battery_voltage", "tlm.hk.bus_current"],
            "scope_mode": "context",
            "data_mode": "context",
            "value_type": "engineering",
            "sampling": "decimated_envelope",
            "overlays": ["limits", "events", "quality"]
          },
          "options": {
            "show_min_max_band": true,
            "legend": true
          }
        }
      }
    }
  ],
  "metadata": {
    "labels": ["golden", "tier0", "limits"]
  }
}
