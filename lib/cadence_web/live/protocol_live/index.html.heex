<.breadcrumb items={[
  {"Interfaces", ~p"/missions/#{@mission}/interfaces"},
  {@interface.name, nil}
]} />

<.header>
  Protocol Chain for {@interface.name}
  <:subtitle>
    Configure the protocol chain for packet processing. READ protocols execute top-to-bottom, WRITE protocols execute bottom-to-top.
  </:subtitle>
  <:actions>
    <.link patch={~p"/missions/#{@mission}/interfaces/#{@interface}/protocols/new"}>
      <.button>Add Protocol</.button>
    </.link>
  </:actions>
</.header>

<div class="mb-4">
  <.list>
    <:item title="Interface">{@interface.name}</:item>
    <:item title="Connection Type">
      {String.replace(@interface.connection_type || "none", "_", " ") |> String.capitalize()}
    </:item>
    <:item title="Protocol Count">{length(@protocols)}</:item>
  </.list>
</div>

<%= if Enum.empty?(@protocols) do %>
  <div class="text-center py-12 border border-dashed border-base-300 rounded-sm mt-4 bg-base-200/30">
    <.icon name="hero-document-text" class="mx-auto h-12 w-12 text-base-content/30" />
    <h3 class="mt-2 text-sm font-semibold text-base-content">No protocols configured</h3>
    <p class="mt-1 text-sm text-base-content/60">
      Get started by adding your first protocol to the chain.
    </p>
    <div class="mt-6">
      <.link patch={~p"/missions/#{@mission}/interfaces/#{@interface}/protocols/new"}>
        <.button>
          <.icon name="hero-plus" class="-ml-0.5 mr-1.5 h-5 w-5" /> Add Protocol
        </.button>
      </.link>
    </div>
  </div>
<% else %>
  <div class="space-y-2">
    <%= for {protocol, index} <- Enum.with_index(@protocols) do %>
      <div class="hud-panel flex items-center gap-4 p-4">
        <div class="flex flex-col gap-1">
          <button
            phx-click="move_up"
            phx-value-id={protocol.id}
            disabled={index == 0}
            class={[
              "rounded-sm p-1 hover:bg-base-300 transition-colors",
              index == 0 && "cursor-not-allowed opacity-30"
            ]}
          >
            <.icon name="hero-chevron-up" class="h-4 w-4" />
          </button>
          <button
            phx-click="move_down"
            phx-value-id={protocol.id}
            disabled={index == length(@protocols) - 1}
            class={[
              "rounded-sm p-1 hover:bg-base-300 transition-colors",
              index == length(@protocols) - 1 && "cursor-not-allowed opacity-30"
            ]}
          >
            <.icon name="hero-chevron-down" class="h-4 w-4" />
          </button>
        </div>

        <div class="flex-shrink-0">
          <div class="flex h-10 w-10 items-center justify-center rounded-sm bg-primary/20 text-primary font-semibold">
            {protocol.order}
          </div>
        </div>

        <div class="flex-1">
          <div class="flex items-center gap-2">
            <h3 class="text-lg font-semibold text-base-content">
              {format_protocol_type(protocol.protocol_type)}
            </h3>
            <.status_badge status={protocol.protocol_direction} />
          </div>
          <div class="mt-1 text-sm text-base-content/60">
            {protocol_config_summary(protocol)}
          </div>
        </div>

        <div class="flex gap-2">
          <.link patch={
            ~p"/missions/#{@mission}/interfaces/#{@interface}/protocols/#{protocol}/edit"
          }>
            <.button variant="secondary">Edit</.button>
          </.link>
          <.button
            phx-click="delete"
            phx-value-id={protocol.id}
            data-confirm="Are you sure you want to delete this protocol? This will affect the protocol chain."
            variant="danger"
          >
            Delete
          </.button>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<.modal
  :if={@live_action in [:new, :edit]}
  id="protocol-modal"
  show
  on_cancel={JS.patch(~p"/missions/#{@mission}/interfaces/#{@interface}/protocols")}
>
  <.live_component
    module={CadenceWeb.ProtocolLive.FormComponent}
    id={@protocol.id || :new}
    title={@page_title}
    action={@live_action}
    protocol={@protocol}
    interface={@interface}
    mission={@mission}
    patch={~p"/missions/#{@mission}/interfaces/#{@interface}/protocols"}
  />
</.modal>
