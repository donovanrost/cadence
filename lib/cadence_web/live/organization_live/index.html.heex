<.header>
  Organizations
  <:actions>
    <.link patch={~p"/admin/organizations/new"}>
      <.button>New Organization</.button>
    </.link>
  </:actions>
</.header>

<.table
  id="organizations"
  rows={@streams.organizations}
  row_click={fn {_id, organization} -> JS.navigate(~p"/admin/organizations/#{organization}") end}
>
  <:col :let={{_id, organization}} label="Name"><%= organization.name %></:col>
  <:col :let={{_id, organization}} label="Slug"><%= organization.slug %></:col>
  <:col :let={{_id, organization}} label="Status"><%= organization.status %></:col>
  <:col :let={{_id, organization}} label="Tier"><%= organization.subscription_tier %></:col>
  <:col :let={{_id, organization}} label="Missions">
    <%= organization.max_missions %>
  </:col>
  <:action :let={{_id, organization}}>
    <.link
      navigate={~p"/admin/organizations/#{organization}"}
      class="flex items-center gap-2 hover-glow-cyan transition-glow"
    >
      <.icon name="hero-eye" class="h-4 w-4" />
      View Details
    </.link>
  </:action>
  <:action :let={{_id, organization}}>
    <.link
      patch={~p"/admin/organizations/#{organization}/edit"}
      class="flex items-center gap-2 hover-glow-cyan transition-glow"
    >
      <.icon name="hero-pencil" class="h-4 w-4" />
      Edit
    </.link>
  </:action>
  <:action :let={{id, organization}}>
    <.link
      phx-click={JS.push("delete", value: %{id: organization.id}) |> hide("##{id}")}
      data-confirm="Are you sure?"
      class="flex items-center gap-2 text-error hover-glow-pink transition-glow"
    >
      <.icon name="hero-trash" class="h-4 w-4" />
      Delete
    </.link>
  </:action>
</.table>

<.modal
  :if={@live_action in [:new, :edit]}
  id="organization-modal"
  show
  on_cancel={JS.patch(~p"/admin/organizations")}
>
  <.live_component
    module={CadenceWeb.OrganizationLive.FormComponent}
    id={@organization.id || :new}
    title={@page_title}
    action={@live_action}
    organization={@organization}
    patch={~p"/admin/organizations"}
  />
</.modal>
