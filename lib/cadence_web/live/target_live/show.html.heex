<.breadcrumb items={[
  {"Targets", ~p"/missions/#{@mission}/targets"},
  {@target.name, nil}
]} />

<.header>
  {@target.name}
  <:subtitle>{@target.identifier}</:subtitle>
  <:actions>
    <.link patch={~p"/missions/#{@mission}/targets/#{@target}/edit"}>
      <.button>Edit Target</.button>
    </.link>
  </:actions>
</.header>

<!-- Target Details Grid -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
  <div class="hud-panel p-4">
    <div class="hud-label mb-1">Type</div>
    <div class="text-base-content font-medium capitalize">
      {String.replace(@target.type, "_", " ")}
    </div>
  </div>

  <div class="hud-panel p-4">
    <div class="hud-label mb-1">Status</div>
    <div><.status_badge status={@target.status} /></div>
  </div>

  <div class="hud-panel p-4">
    <div class="hud-label mb-1">Circuit Breaker</div>
    <div class="flex items-center gap-2">
      <.status_badge status={@target.circuit_breaker_status} />
      <%= if @target.circuit_breaker_failures > 0 do %>
        <span class="text-xs text-base-content/50">
          ({@target.circuit_breaker_failures} failures)
        </span>
      <% end %>
    </div>
  </div>

  <div class="hud-panel p-4">
    <div class="hud-label mb-1">Mission</div>
    <div>
      <.link
        navigate={~p"/missions/#{@mission}"}
        class="text-primary hover:text-primary/80 font-medium"
      >
        {@mission.name}
      </.link>
    </div>
  </div>
</div>

<!-- Config & Metadata side by side if both exist -->
<%= if @target.config != %{} or @target.metadata != %{} do %>
  <div class={[
    "grid gap-4 mt-6",
    @target.config != %{} && @target.metadata != %{} && "md:grid-cols-2"
  ]}>
    <%= if @target.config != %{} do %>
      <div class="hud-panel p-4">
        <div class="hud-label mb-2">Configuration</div>
        <pre class="text-base-content bg-base-200/50 rounded-sm p-3 text-xs font-mono overflow-x-auto max-h-48"><%= Jason.encode!(@target.config, pretty: true) %></pre>
      </div>
    <% end %>

    <%= if @target.metadata != %{} do %>
      <div class="hud-panel p-4">
        <div class="hud-label mb-2">Metadata</div>
        <pre class="text-base-content bg-base-200/50 rounded-sm p-3 text-xs font-mono overflow-x-auto max-h-48"><%= Jason.encode!(@target.metadata, pretty: true) %></pre>
      </div>
    <% end %>
  </div>
<% end %>

<!-- Associated Interfaces -->
<div class="mt-6">
  <div class="hud-label mb-3">Associated Interfaces</div>
  <%= if Enum.empty?(@interfaces) do %>
    <div class="hud-panel p-4 text-base-content/50 italic text-sm">
      No interfaces associated with this target.
      <.link navigate={~p"/missions/#{@mission}"} class="text-primary hover:text-primary/80">
        Configure interfaces
      </.link>
      in the mission settings.
    </div>
  <% else %>
    <.table id="target-interfaces" rows={@interfaces}>
      <:col :let={interface} label="Interface">{interface.name}</:col>
      <:col :let={interface} label="Connection">
        {String.replace(interface.connection_type || "none", "_", " ") |> String.capitalize()}
      </:col>
      <:col :let={interface} label="Status">
        <.status_badge status={interface.status} />
      </:col>
    </.table>
  <% end %>
</div>
